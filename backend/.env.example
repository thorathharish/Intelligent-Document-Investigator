# Copy to backend/.env and fill in OPENROUTER_API_KEY. Never commit .env.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
OPENROUTER_FALLBACK_MODELS=
LLM_MODE=live
LLM_SUPPORTS_JSON_MODE=false
LLM_SUPPORTS_VISION=false
LLM_TIMEOUT_S=45
LLM_MIN_GAP_S=3
LLM_MAX_TOKENS=2000
PROMPT_VERSION=1
EMBED_MODEL=BAAI/bge-small-en-v1.5
TOP_K=10
MAX_FILE_MB=20
MAX_FILES=10
DATA_DIR=./data
# Deployed frontend origin(s) allowed to call the API, comma-separated. Leave empty for local development.
ALLOWED_ORIGINS=
ENABLE_TIMELINE=false
ENABLE_GRAPH=false
