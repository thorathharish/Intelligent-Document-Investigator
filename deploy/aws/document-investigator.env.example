# Copied to /etc/document-investigator.env by setup.sh (owner root, mode 600). Never commit the real file.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_FALLBACK_MODELS=qwen/qwen3.8-27b:free,openrouter/free
LLM_MODE=replay
LLM_SUPPORTS_JSON_MODE=false
LLM_TIMEOUT_S=45
LLM_MIN_GAP_S=3
PROMPT_VERSION=1
# database, uploads and recordings; survives restarts and reboots
DATA_DIR=/var/lib/document-investigator
# keeps the embedding model on disk instead of /tmp
FASTEMBED_CACHE_PATH=/var/lib/document-investigator/models
# only needed when the frontend is hosted on another origin; empty when Nginx serves both
ALLOWED_ORIGINS=
